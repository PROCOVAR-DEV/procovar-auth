// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  /// Nombre de usuario, para entrar sin correo.
  ///
  /// En PEDIDO la gente entra con `yasmani`, `claudia.hab`, `rene`… y muchos no
  /// tienen correo. Obligarles a uno para poder entrar aquí sería inventarles
  /// una dirección que no leen y una forma de identificarse que no reconocen.
  ///
  /// El correo sigue siendo obligatorio porque better-auth lo usa como clave de
  /// la cuenta; a quien no tenga se le pone uno interno (`usuario@procovar.local`)
  /// que no recibe nada y que nadie necesita saberse.
  username      String?        @unique
  emailVerified Boolean
  image         String?
  isSystemAdmin Boolean        @default(false)
  phone         String?
  /// El rol que se le dio al abrir la cuenta.
  ///
  /// Vive en la persona y no solo en sus membresías porque la cuenta se abre SIN
  /// sucursal: si el rol solo existiera dentro de una membresía, quien no está en
  /// ninguna no tendría rol, y al meterlo en su primera sucursal habría que
  /// volver a preguntárselo —que es exactamente lo que no se quiere—.
  ///
  /// Es el que se hereda al entrar en una sucursal. Si algún día alguien tiene que
  /// llevar un rol distinto en una sucursal concreta, eso se cambia en la sucursal,
  /// que es donde se ve a quién afecta.
  defaultRoleId String?
  defaultRole   Role?          @relation(fields: [defaultRoleId], references: [id], onDelete: SetNull)
  /// El código con el que esta persona vende: `andy.almanza`.
  ///
  /// Vive en la PERSONA y no en una tabla aparte porque en la operación real vendedor
  /// y usuario son el mismo: se comprobó sobre los 82 vendedores activos de PEDIDO y
  /// la relación es uno a uno, sin una sola excepción. Tenerlos separados obligaba a
  /// emparejarlos —y a esperar al primer pedido de alguien para saber quién era—.
  ///
  /// Nulo en quien no vende: un administrador o un operador no tienen código.
  codigoVendedor String?       @unique

  /// Si sigue en la organización.
  ///
  /// Quien se va NO se borra: sus pedidos siguen colgando de él —2.210 sólo de una de
  /// las bajas— y borrarlo los dejaría sin dueño. Se marca y desaparece de las listas.
  activo        Boolean        @default(true)

  /// Quién lo supervisa, cuando lo tiene.
  ///
  /// Es la ÚNICA jerarquía real de la operación: un supervisor sobre varios
  /// vendedores. No existe "gestor de vendedor" — ese campo en PEDIDO está mal
  /// nombrado y lo que guarda es la cuenta del propio vendedor.
  ///
  /// Hoy esta relación vive en la configuración de Analytics, escrita a mano. Aquí
  /// queda donde se puede consultar y donde ya está la persona.
  supervisorId  String?
  supervisor    User?          @relation("Supervision", fields: [supervisorId], references: [id], onDelete: SetNull)
  supervisados  User[]         @relation("Supervision")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  refreshTokens RefreshToken[]

  @@index([codigoVendedor])
  @@index([supervisorId])
  @@map("user")
}

model Session {
  id                   String    @id @default(cuid())
  userId               String
  token                String    @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  clientId             String?
  revokedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Las sesiones de una persona (panel «Dispositivos y sesiones», cerrar todas, baja): sin esto era un recorrido de la tabla.
  @@index([userId])
  @@map("session")
}

/// El refresh de la APK. Opaco, de UN SOLO USO y sustituido entero en cada
/// renovación (`docs/identidad.md` de delivery-logistica).
///
/// Va en una tabla y no en Redis porque su trabajo más importante lo hace DESPUÉS
/// de gastarse: una fila usada se conserva precisamente para poder reconocerla si
/// vuelve a aparecer. Un token que se borra al usarlo no se distingue de uno
/// inventado, y entonces el robo no se detecta nunca.
///
/// Del token **no se guarda el valor**, sino su sha256. Quien se lleve un volcado
/// de la base no se lleva ninguna sesión. Es sha256 y no argon2 a propósito: aquí
/// el secreto son 32 bytes al azar, no una contraseña humana, así que no hay
/// diccionario contra el que encarecer el intento — y esto se comprueba en cada
/// renovación de cada aparato.
model RefreshToken {
  id        String    @id @default(cuid())
  /// sha256 (hex) del token que se le dio al aparato.
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// La sesión de better-auth que abrió este aparato. Revocarla desde el panel
  /// cierra la APK en la siguiente renovación, o sea como mucho en 15 minutos.
  sessionId String?
  /// La cadena de renovaciones que arrancó con un acceso. Sirve para cerrar UN
  /// aparato (logout) sin tocar los demás; la reutilización, en cambio, se lleva
  /// por delante la cuenta entera.
  familyId  String
  /// Qué aplicación lo pidió, para la auditoría: "delivery-apk".
  clientId  String?
  expiresAt DateTime
  /// Cuándo se gastó. No nulo = ya se canjeó: si vuelve, es robo.
  usedAt    DateTime?
  revokedAt DateTime?
  /// Cuándo se concedió LA gracia de esta fila. La ventana de gracia deja que un
  /// refresh ya gastado valga unos segundos más —una respuesta que se perdió por
  /// el camino no es un robo—, pero eso vale UNA vez y no una por intento: cada
  /// concesión abre una rama nueva de 30 días, y sin este tope un refresh robado
  /// podía abrir tantas como quisiera y dejar la cuenta un mes sin detección.
  /// Se reclama con un `updateMany` condicionado a que esté a null, igual que
  /// `usedAt`, que es lo único que aguanta cinco peticiones a la vez.
  graceUsedAt DateTime?
  /// El que salió al canjear este. Deja ver la cadena entera en una auditoría.
  replacedBy String?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_token")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

/// La tasa de cambio USD -> CUP de cada sucursal.
///
/// Vive AQUÍ porque es un dato de la sucursal, y la sucursal es de Accesos. Estaba sólo
/// en PEDIDO, así que delivery se apañaba con una tasa escrita a mano en su pantalla de
/// Configuración: dos números para lo mismo, y un domicilio que vale distinto según dónde
/// se mire. Eso no falla en pantalla — sale un importe creíble y cuadra mal en la caja.
///
/// El valor lo pone la API de Entrega, que ya la mantiene para su aplicación. Se trae de
/// ahí en vez de teclearla para que todos cobren con la MISMA.
model TasaCambio {
  /// El CÓDIGO de la sucursal (CAM, HAB, STG…), que es la clave que cruza todo.
  codigo    String   @id
  /// Cuántos CUP vale un USD.
  cupPorUsd Float
  /// La TARIFA BASE de esa sucursal, en CUP por km y por kg.
  ///
  /// Es el otro número con el que Entrega cobra un domicilio: el importe es
  /// `tarifa_base × distancia × peso`. Viene en la misma respuesta que la tasa, así que
  /// guardarlo cuesta nada y evita que quien tenga que calcular lo mismo —delivery, para
  /// los pedidos que se meten a mano— se invente una fórmula propia.
  tarifaBase Float?
  /// De dónde salió: "entrega", "manual", el nombre de quien la puso.
  fuente    String?
  /// Cuándo se trajo. Una tasa sin saber de cuándo es no se puede usar para cobrar: en
  /// Cuba se mueve a diario y un importe calculado con la de la semana pasada está mal
  /// sin que el número lo diga.
  traidoAt  DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([traidoAt])
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  logo        String?
  metadata    String?

  /// El código con el que TODOS los sistemas se refieren a esta sucursal: CAM, STG,
  /// HAB… Es la clave que ya cruza PEDIDO (`Sucursal.codigo`), delivery
  /// (`Branch.externalId`), Rutas (`sucursal.codigo`) y el consolidado de Parranda.
  /// Existía en los cuatro por separado y en ninguno como fuente.
  codigo      String?      @unique

  /// Si la sucursal opera. Cerrarla no la borra: sus pedidos, rutas e histórico
  /// siguen colgando de ella.
  activa      Boolean      @default(true)

  /// Todas están en Cuba hoy, pero los cálculos de jornada y de "qué día es este
  /// fichero GPS" dependen de esto, y darlo por hecho es lo que hace que un informe
  /// salga corrido una hora sin que nadie sepa por qué.
  timezone    String       @default("America/Havana")

  telefono    String?
  direccion   String?
  latitud     Float?
  longitud    Float?

  /// Los ALMACENES de esta sucursal. Ver el modelo `Almacen`.
  ///
  /// Estuvieron aquí dentro como cuatro campos sueltos —almacenNombre, almacenLatitud…—
  /// dando por hecho que cada sucursal tiene uno. No es cierto: una sucursal puede
  /// tener varios, y con un solo juego de campos el segundo no cabe. Quien lo
  /// necesitara acabaría metiéndolo en la dirección del primero.
  almacenes   Almacen[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     Member[]
  invitations Invitation[]

  @@index([codigo])
  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberRoles    MemberRole[]

  @@unique([userId, organizationId])
  @@map("member")
}

model Invitation {
  id                 String       @id @default(cuid())
  organizationId     String
  email              String
  role               String
  status             String
  tokenHash          String?
  inviterId          String
  expiresAt          DateTime
  createdAt          DateTime     @default(now())
  acceptedAt         DateTime?
  roleId             String?
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter            User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

// Aquí vivían Plan y Subscription, con sus enums de estado y ciclo de
// facturación: planes de pago del producto del que salió este código. Procovar
// no le cobra una suscripción a su propia gente. Estaban vacíos.

// ── Identity Hub: Service-to-Service & API keys ──────────

/// External application / microservice that delegates auth to qb-auth.
/// `clientSecretHash` is currently unused (per-client signing keys are derived
/// from SERVICE_AUTH_SECRET via HMAC). Reserved for future per-client static
/// secrets (e.g. webhook-style signing).
model ClientApp {
  id                  String   @id @default(cuid())
  clientId            String   @unique /// Stable identifier (e.g. "qb-booking")
  name                String
  description         String?
  clientSecretHash    String? /// argon2id hash, optional
  signingKeyVersion   Int      @default(1) /// bump to rotate the derived signing key
  allowedCallbackUrls String[] @default([]) /// exact origin+path match
  allowedDomains      String[] @default([]) /// host (or parent host) for returnTo
  scopes              String[] @default([]) /// e.g. ['callback:create','session:verify']
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  apiKeys             ApiKey[]

  @@map("client_app")
}

// TenantDomain también se fue: servía para que cada propietario de
// alojamientos pusiera su propio dominio como destino de vuelta del login. Las
// aplicaciones de Procovar son cuatro y sus dominios están en client_app.


/// API key for human/script access. The plaintext key is shown once on
/// creation and then only its argon2id hash is stored.
model ApiKey {
  id          String     @id @default(cuid())
  prefix      String     @unique /// 8 hex chars, public lookup
  hash        String /// argon2id of the secret part
  name        String
  scopes      String[]   @default([])
  clientAppId String?
  userId      String?
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime   @default(now())
  clientApp   ClientApp? @relation(fields: [clientAppId], references: [id], onDelete: SetNull)

  @@index([clientAppId])
  @@index([userId])
  @@map("api_key")
}

/// Audit trail for security-relevant actions.
model AuditLog {
  id        String   @id @default(cuid())
  action    String /// e.g. "callback.create", "auth.code.exchange", "session.revoke"
  resource  String?
  clientId  String?
  userId    String?
  ip        String?
  ua        String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_log")
}

/// Asymmetric signing keypair used for RS256 JWTs and exposed via JWKS.
/// Multiple non-revoked keys may exist simultaneously (rotation grace).
/// The most recently created non-revoked, non-expired key is used to sign.
model JwksKey {
  id         String    @id @default(cuid())
  kid        String    @unique /// JWKS key id (also kept in JWT header)
  alg        String    @default("RS256")
  publicPem  String    @db.Text
  privatePem String    @db.Text /// stored encrypted-at-rest only by Postgres TDE; access via env-only
  active     Boolean   @default(true) /// false = do not sign with this key (still verified)
  revokedAt  DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([active, revokedAt])
  @@map("jwks_key")
}

/// Runtime key-value store for system configuration (e.g. service URLs).
/// Values here override env-var fallbacks so domain changes don't require redeployment.
model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

// ── RBAC: Permissions / Roles ────────────────────────────

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  resource        String
  action          String
  service         String
  group           String
  label           Json
  description     Json?
  isDeprecated    Boolean          @default(false)
  rolePermissions RolePermission[]

  @@map("permission")
}

/// Catálogo de roles, ÚNICO para todo Procovar.
///
/// NO cuelga de la organización a propósito. La organización es la SUCURSAL, y
/// los roles son los mismos en las ocho: Super Admin, Administrador, Supervisor,
/// Gestor, Operador. Colgarlo de cada una obligaría a crear "Operador" ocho
/// veces y, el día que cambie lo que puede hacer, a tocarlas todas — o quedarían
/// distintas sin que nadie lo notara.
///
/// Lo que cambia de una persona a otra no es el rol: es EN QUÉ SUCURSAL lo
/// tiene, y eso ya lo dice su `Member`. El rol se le asigna a la PERSONA
/// (`MemberRole`), y lo editan el Super Admin o el Administrador.
model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  color       String?
  icon        String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  memberRoles MemberRole[]
  usuarios    User[]

  @@map("role")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permission")
}

/// Esta persona tiene este rol.
///
/// El ALCANCE no se guarda aquí: sale del `Member`, que ya pertenece a una
/// sucursal. "Yasmani es Operador en Camagüey" es esta fila más su miembro.
/// Si mañana lleva también Holguín, es otro miembro con el mismo rol — sin
/// duplicar el rol.
///
/// Se quitó el alcance por PROPIEDAD (`scopeAllProperties`, `propertyIds`): era
/// del negocio de alojamientos. En Procovar no hay propiedades.
model MemberRole {
  id       String @id @default(cuid())
  memberId String
  roleId   String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([memberId, roleId])
  @@map("member_role")
}

/// Evidence that a customer accepted the published legal terms before paying.
/// Kept in qb-auth (the identity + checkout owner) and referenced by invoice /
/// reservation id — those live in qb-back, so they are opaque strings here,
/// never foreign keys (same posture as every other qb-back id in this schema).
model TermsAcceptance {
  id            String   @id @default(cuid())
  authUserId    String
  invoiceId     String?
  reservationId String?
  /// Version of the legal corpus accepted (COMPANY.termsVersion).
  termsVersion  String
  /// Slugs of the documents shown/accepted, e.g. ["condiciones","cancelaciones"].
  documents     String[]
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([authUserId])
  @@index([invoiceId])
  @@map("terms_acceptances")
}


/// Un almacén: de dónde sale la mercancía.
///
/// No es lo mismo que la sucursal, y por eso es una tabla y no unos campos dentro: el
/// domicilio se cobra por la distancia desde EL ALMACÉN, no desde la oficina. Una
/// sucursal grande tiene varios, y hasta ahora sólo cabía uno.
///
/// Vive aquí y no sólo en delivery (`SavedOrigin`) porque es el dato con el que se
/// cobra: si esa aplicación se apaga, se pierde.
model Almacen {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  nombre    String
  direccion String?
  latitud   Float?
  longitud  Float?

  /// El código del almacén en Ventra (`objectCode`), el mismo que PEDIDO manda dentro de cada
  /// pedido. Sin él Reparto no puede saber de qué almacén sale un pedido y lo mide desde el
  /// principal. Es de la SUCURSAL: el «2» es PV CAMAGUEY en Camagüey y AURORA en Santiago, por
  /// eso la unicidad es (sucursal, código). Se rellena desde la pantalla de Almacenes de Reparto.
  /// Null = sin código todavía (Postgres no cuenta los nulos en un índice único).
  codigo    String?

  /// El que se usa cuando nadie dice cuál. Con varios almacenes hay que poder decir
  /// desde cuál se mide por defecto, o cada aplicación elegiría uno distinto.
  principal Boolean      @default(false)
  activo    Boolean      @default(true)

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([orgId, codigo])
  @@index([orgId])
  @@index([orgId, principal])
}
