    "help": {
      "whatIsThis": {
        "title": "What is this page?",
        "description": "qb-auth is the central Identity Hub. From here you provision the credentials each microservice uses to authenticate against qb-auth (verify sessions, mint JWTs, validate API keys). It does NOT issue cross-service master keys — every service has its OWN credential."
      },
      "noKey": {
        "title": "Important: there is no global signing key",
        "p1": "<strong>SERVICE_AUTH_SECRET</strong> is the master secret that lives ONLY in qb-auth's env. Every per-client signing key is derived from it via:",
        "p2": "The key you copy after creating a Service Client is <strong>only that client's key</strong>. It identifies it when calling qb-auth — it does NOT grant access to other microservices' endpoints (qb-back, qb-notify… each enforce their own auth).",
        "p3": "The <code>*</code> wildcard scope on a client (e.g. <code>qb-admin</code>) only widens what that client can do <em>against qb-auth</em> — never against other services."
      },
      "credTypes": {
        "title": "The 3 credential types",
        "subtitle": "Pick the right one for each integration."
      },
      "credential": {
        "serviceClient": {
          "title": "Service Client (HMAC)",
          "chip": "signingKey",
          "when": "A backend (qb-back, qb-panel, qb-notify…) needs to call qb-auth as itself.",
          "how1": "Created here → signingKey shown ONCE.",
          "how2": "Identifies ONE client (its clientId) — NOT a master key.",
          "how3": "Sent as the X-Service-Auth header on requests TO qb-auth.",
          "how4": "qb-auth verifies it by re-deriving via HMAC(SERVICE_AUTH_SECRET, 'svc:v<n>:<clientId>')."
        },
        "apiKey": {
          "title": "API Key (qbk_…)",
          "chip": "apiKey",
          "when": "Third-party / human / scripts hitting the hub.",
          "how1": "Created here → full token shown ONCE.",
          "how2": "Sent as Authorization: Bearer qbk_…",
          "how3": "Verified via POST /api/auth/api-keys/verify."
        },
        "adminSession": {
          "title": "Admin user session",
          "chip": "cookie",
          "when": "Humans using this dashboard.",
