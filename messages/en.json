      "accordion": {
        "onboard": {
          "ariaLabel": "Create service client",
          "title": "How do I onboard a new microservice?",
          "step1": "Open the <strong>Service Clients</strong> tab and click <em>New Client</em>.",
          "step2": "Pick a preset (e.g. <em>Consumer backend</em>) — it pre-fills scopes for you.",
          "step3": "Copy the derived <code>signingKey</code> shown ONCE on success and paste it into the consumer's <code>SERVICE_SIGNING_KEY</code> env var.",
          "step4": "Set <code>SERVICE_CLIENT_ID</code> and <code>SERVICE_KEY_VERSION=1</code> on the consumer.",
          "step5Prefix": "Test with",
          "step5Suffix": "it should return"
        },
        "rotate": {
          "ariaLabel": "Rotate",
          "title": "How do I rotate a signing key without downtime?",
          "step1": "Click <em>Rotate</em> on the client row. Version goes 1 → 2.",
          "step2": "Roll out the new <code>SERVICE_SIGNING_KEY</code> + <code>SERVICE_KEY_VERSION=2</code> to all instances.",
          "step3": "qb-auth still accepts both versions for a grace window. Watch audit logs for any caller stuck on v1, then revoke v1 if needed."
        },
        "scopes": {
